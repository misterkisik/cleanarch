# Maintainer: MisterKisik
# Локальная сборка и установка пакета: makepkg -p PKGBUILD.local -si

pkgname=cleanarch
pkgver=1.0.0
pkgrel=1
pkgdesc="Графическая утилита очистки кэшей pacman/yay, системных логов и обновления Arch Linux"
arch=('any')
license=('GPL-3.0-or-later')
depends=(
    'python'
    'python-gobject'
    'gtk4'
    'libadwaita'
)
makedepends=(
    'python-build'
    'python-installer'
    'python-wheel'
    'python-setuptools'
)
optdepends=(
    'yay: для очистки кэша AUR'
    'pacman-contrib: утилита paccache'
    'polkit: графический запрос пароля (pkexec)'
)
source=()
sha256sums=()

build() {
    cd "$startdir"
    if command -v python -m build &>/dev/null; then
        python -m build --wheel --no-isolation
    else
        python setup.py bdist_wheel
    fi
}

package() {
    cd "$startdir"
    python -m installer --destdir="$pkgdir" dist/*.whl

    install -Dm644 "$startdir/data/cleanarch.desktop" "$pkgdir/usr/share/applications/cleanarch.desktop"
    ln -s cleanarch.desktop "$pkgdir/usr/share/applications/org.cleanarch.CleanArch.desktop"
    install -Dm644 "$startdir/data/cleanarch.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/cleanarch.png"
    ln -s cleanarch.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/org.cleanarch.CleanArch.png"
    install -Dm644 "$startdir/data/cleanarch.png" "$pkgdir/usr/share/pixmaps/cleanarch.png"
    ln -s cleanarch.png "$pkgdir/usr/share/pixmaps/org.cleanarch.CleanArch.png"
    install -Dm644 "$startdir/data/cleanarch.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/cleanarch.svg"
    ln -s cleanarch.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.cleanarch.CleanArch.svg"
    install -Dm644 "$startdir/data/mascot.png" "$pkgdir/usr/share/cleanarch/mascot.png"
}
